describe('Automação de Acessibilidade — Portal Banco Inter', () => {
  
  // Impede o Cypress de quebrar o teste por falhas de programação internas do site do Inter
  Cypress.on('uncaught:exception', () => false);

  it('Deve carregar a homepage e escanear a estrutura do HTML contra a WCAG', () => {
    
    // 1. Visita o portal oficial com tempo de segurança para carregamento
    cy.visit('https://inter.co', {
      timeout: 90000
    });

    // 2. Injeta a biblioteca especialista axe-core na árvore do DOM
    cy.injectAxe();

    // 3. Executa a varredura completa nas regras obrigatórias de nível A e AA
    cy.checkA11y(null, {
      runOnly: {
        type: 'tag',
        values: ['wcag2a', 'wcag21a', 'wcag2aa', 'wcag21aa']
      }
    });

  });
});
